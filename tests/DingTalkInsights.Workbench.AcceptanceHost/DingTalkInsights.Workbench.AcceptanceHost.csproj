<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed><PublishAot>false</PublishAot><PublishSingleFile>false</PublishSingleFile>
    <WorkbenchSnapshotRoot Condition="'$(WorkbenchSnapshotRoot)' == ''">$(MSBuildThisFileDirectory)../../eng/vendor/workbench-6565180b</WorkbenchSnapshotRoot>
    <ApplicationManifest>$(WorkbenchSnapshotRoot)/src/Workbench.App/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="$(WorkbenchSnapshotRoot)/src/Workbench.Core/Workbench.Core.csproj" />
    <ProjectReference Include="$(WorkbenchSnapshotRoot)/src/Workbench.WinUI.Sdk/Workbench.WinUI.Sdk.csproj" />
    <!-- Separate source-linked production-control fixture; never reference/preload the business plugin DLL. -->
    <ProjectReference Include="../../src/DingTalkInsights.Runtime/DingTalkInsights.Runtime.csproj" />
    <Compile Include="../../src/DingTalkInsights.Workbench/InsightPage.cs" Link="ProductionAdapter/InsightPage.cs" />
    <Compile Include="../../src/DingTalkInsights.Workbench/PluginSession.cs" Link="ProductionAdapter/PluginSession.cs" />
    <Compile Include="../../src/DingTalkInsights.Workbench/NativeActionGate.cs" Link="ProductionAdapter/NativeActionGate.cs" />
    <ApplicationDefinition Include="$(WorkbenchSnapshotRoot)/src/Workbench.App/App.xaml" Link="App.xaml" />
    <Compile Include="$(WorkbenchSnapshotRoot)/src/Workbench.App/MainWindow.cs" Link="Presenter/MainWindow.cs" />
    <Compile Include="$(WorkbenchSnapshotRoot)/src/Workbench.App/ShellPages.cs" Link="Presenter/ShellPages.cs" />
    <Compile Include="$(WorkbenchSnapshotRoot)/src/Workbench.App/Ui.cs" Link="Presenter/Ui.cs" />
    <Compile Include="$(WorkbenchSnapshotRoot)/src/Workbench.App/HostRuntime.cs" Link="Presenter/HostRuntime.cs" />
    <Compile Include="$(WorkbenchSnapshotRoot)/src/Workbench.App/RunOptions.cs" Link="Presenter/RunOptions.cs" />
    <Compile Include="$(WorkbenchSnapshotRoot)/src/Workbench.App/NativeSmoke.cs" Link="Presenter/NativeSmoke.cs" />
  </ItemGroup>
</Project>
